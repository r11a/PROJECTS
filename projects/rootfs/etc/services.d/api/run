#!/usr/bin/with-contenv sh
set -eu

export PGHOST=/run/postgresql
export PGUSER=postgres
export PGDATABASE=projects

until pg_isready -q -h "$PGHOST" -U "$PGUSER"; do
  sleep 1
done

cd /opt/projects
while true; do
  if [ -s /data/restore.request ]; then
    restore_file="$(cat /data/restore.request)"
    case "$restore_file" in
      /data/backups/*.dump|/data/backups/*.projects-backup) ;;
      *) echo "Invalid restore request"; rm -f /data/restore.request; exit 1 ;;
    esac
    if [ ! -f "$restore_file" ]; then
      echo "Restore file does not exist: $restore_file"
      rm -f /data/restore.request
      exit 1
    fi
    database_dump="$restore_file"
    restore_staging=/data/restore-staging
    full_restore=0
    case "$restore_file" in
      *.projects-backup)
        full_restore=1
        rm -rf /data/restore-staging
        mkdir -p "$restore_staging"
        tar -xzf "$restore_file" -C "$restore_staging"
        database_dump="$restore_staging/database.dump"
        if [ ! -s "$database_dump" ]; then
          echo "Backup package does not contain database.dump"
          rm -f /data/restore.request
          exit 1
        fi
        ;;
    esac
    dropdb --if-exists --force -h "$PGHOST" -U "$PGUSER" projects
    createdb -h "$PGHOST" -U "$PGUSER" projects
    pg_restore --no-owner --no-privileges -h "$PGHOST" -U "$PGUSER" -d projects "$database_dump"
    if [ "$full_restore" -eq 1 ] && [ -d "$restore_staging/files/uploads" ]; then
      rm -rf /data/uploads
      mkdir -p /data/uploads
      cp -a "$restore_staging/files/uploads/." /data/uploads/
    fi
    if [ "$full_restore" -eq 1 ] && [ -d "$restore_staging/files/branding" ]; then
      rm -rf /data/branding
      mkdir -p /data/branding
      cp -a "$restore_staging/files/branding/." /data/branding/
    fi
    if [ "$full_restore" -eq 1 ] && [ -s "$restore_staging/files/ai.secret" ]; then
      cp "$restore_staging/files/ai.secret" /data/ai.secret
      chmod 600 /data/ai.secret
    fi
    rm -rf /data/restore-staging
    rm -f /data/restore.request
    echo "Database restore completed"
  fi

  exit_code=
  node server/index.js || exit_code=$?
  if [ -s /data/restore.request ]; then
    continue
  fi
  echo "PROJECTS API stopped unexpectedly (exit ${exit_code:-1}); restarting in 2 seconds"
  sleep 2
done
